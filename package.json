{
  "name": "phase2-qdrant-rag",
  "version": "1.0.0",
  "description": "Production RAG API with Fastify, TypeScript, Qdrant vector database, and Gemini embeddings",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "qdrant:smoke": "tsx src/scripts/qdrant-smoke.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.16.2",
    "@fastify/cors": "^10.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
